{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "true-path/lib/*.js",
    "true-path/assets/*.js",
    "true-path/types.d.ts"
  ],
  "exclude": ["node_modules"]
}
