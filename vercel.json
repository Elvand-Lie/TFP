{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/true-path/report/:id",
      "destination": "/true-path/report/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "fonts/**,node_modules/@sparticuz/chromium/**,node_modules/puppeteer-core/**,node_modules/@puppeteer/**,node_modules/chromium-bidi/**,node_modules/devtools-protocol/**,node_modules/typed-query-selector/**,node_modules/webdriver-bidi-protocol/**,node_modules/ws/**,node_modules/tar-fs/**,node_modules/mitt/**"
    }
  }
}
