+  color: #cfc8bd;
+}
+
+#zwds-app .zwds-scope-role {
+  font-weight: 800;
+}
+
+#zwds-app .zwds-scope-marker {
+  display: inline-grid;
+  min-width: 1.25em;
+  height: 1.25em;
+  place-items: center;
+  border-radius: 2px;
+  background: rgba(255, 255, 255, .08);
+  color: #ddd4c6;
+  font-size: .52rem;
+  line-height: 1;
+}
+
+/* ── Trine relationship lines (三方四正 arrows) ── */
+#zwds-app .zwds-flight-line--trine {
+  stroke: var(--gold, #C6A96B);
+  stroke-width: 2;
+  stroke-linecap: round;
+  stroke-dasharray: 6 3;
+  opacity: .72;
+}
