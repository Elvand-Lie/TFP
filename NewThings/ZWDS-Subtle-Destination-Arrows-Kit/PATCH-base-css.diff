+  border-color: rgba(198, 169, 107, .48);
+  background: #111113;
+}
+
+#zwds-app .zwds-grid-stage,
+#zwds-app .zwds-grid {
+  background: #111113;
+}
+
+#zwds-app .zwds-palace {
+  border-color: rgba(198, 169, 107, .22);
+  background: #1a1a1d;
+  color: #eee9df;
+}
+
+#zwds-app .zwds-palace:hover {
+  background: #232126;
+}
+
+#zwds-app .zwds-palace.is-flight-destination {
+  background: #28212d;
+}
+
+#zwds-app .zwds-palace__heading strong,
+#zwds-app .zwds-center h2 {
+  color: #f2d7a0;
