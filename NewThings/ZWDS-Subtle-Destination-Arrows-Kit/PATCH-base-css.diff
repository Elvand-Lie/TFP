+/* Site-aligned dark theme: preserve chart geometry while matching The Full Picture. */
+#zwds-app {
+  --zwds-purple: var(--crimson);
+  --zwds-purple-dark: var(--crimson-text);
+  --zwds-purple-soft: rgba(113, 1, 1, .2);
+  --zwds-ink: var(--ivory);
+  --zwds-muted: #aaa6a0;
+  --zwds-line: rgba(198, 169, 107, .2);
+  --zwds-surface: rgba(28, 28, 30, .72);
+  --zwds-canvas: rgba(15, 15, 16, .96);
+  --zwds-red: #ef5350;
+  --zwds-blue: #64b5f6;
+  --zwds-green: #66bb6a;
+  --zwds-gold: var(--gold);
+  background: var(--black);
+  color: var(--ivory);
+  font-family: var(--font-sans);
+  line-height: 1.6;
+}
+
+#zwds-app :focus-visible {
+  outline-color: var(--gold);
+}
+
+#zwds-hero {
+  min-height: 50vh;
+  display: flex;
+  align-items: center;
+  position: relative;
+  overflow: hidden;
+  padding: 140px 48px 80px;
+  border-bottom: 1px solid rgba(113, 1, 1, .15);
+  color: var(--ivory);
+  background:
+    radial-gradient(ellipse at 30% 50%, rgba(113, 1, 1, .12) 0%, transparent 60%),
+    radial-gradient(ellipse at 80% 20%, rgba(198, 169, 107, .06) 0%, transparent 50%);
+}
+
+#zwds-hero .zwds-hero-content {
+  width: 100%;
+  max-width: 1240px;
+}
+
+#zwds-hero .zwds-eyebrow,
+#zwds-app .zwds-kicker {
+  color: var(--gold);
+  font-family: var(--font-sans);
+  font-size: .8rem;
+  font-weight: 500;
+  letter-spacing: .28em;
+  text-transform: uppercase;
+}
