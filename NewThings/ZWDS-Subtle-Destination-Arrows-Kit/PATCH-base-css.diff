+
+#zwds-app .zwds-palace__heading b,
+#zwds-app .zwds-palace__footer,
+#zwds-app .zwds-palace__aux,
+#zwds-app .zwds-center dt {
+  color: #aaa49a;
+}
+
+#zwds-app .zwds-star,
+#zwds-app .zwds-center__facts dd,
+#zwds-app .zwds-center__legend {
+  color: #eee9df;
+}
+
+#zwds-app .zwds-center {
+  background:
+    radial-gradient(circle at 50% 45%, rgba(113, 1, 1, .14), transparent 58%),
+    #171719;
+  color: #eee9df;
+}
+
+#zwds-app .zwds-center header,
+#zwds-app .zwds-center__facts,
+#zwds-app .zwds-center__pillars span {
+  border-color: rgba(198, 169, 107, .25);
+}
+
+#zwds-app .zwds-center__pillars span {
