--- /mnt/data/ZWDS-Inner-Rail-Relationship-Kit/assets/zwds-addon.css	2026-07-23 09:04:40.772344229 +0000
+++ /mnt/data/ZWDS-Subtle-Destination-Arrows-Kit/assets/zwds-addon.css	2026-07-23 09:26:35.520311334 +0000
@@ -399,3 +399,41 @@
   #zwds-app .zwds-center::before { inset: 22px; }
   #zwds-app .zwds-trine-path { stroke-width: .88; }
 }
+
+
+/* ================================================================
+   REFERENCE-STYLE SUBTLE DESTINATION ARROWS
+   The selected and related palace surfaces remain the primary signal.
+   Routes fade from nearly invisible at the source to a tiny crimson
+   arrowhead precisely at each destination border.
+   ================================================================ */
+#zwds-app .zwds-palace.is-trine-source {
+  background: rgba(113, 1, 1, .28) !important;
+  box-shadow: inset 0 0 0 1.35px rgba(239, 107, 107, .90) !important;
+}
+#zwds-app .zwds-palace.is-trine-target,
+#zwds-app .zwds-palace.is-trine-opposite {
+  background: rgba(198, 169, 107, .075) !important;
+  box-shadow: inset 0 0 0 1px rgba(198, 169, 107, .30) !important;
+}
+#zwds-app .zwds-trine-path,
+#zwds-app .zwds-trine-path--opposite {
+  stroke: rgba(216, 208, 196, .10);
+  stroke-width: .72;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  filter: none;
+}
+#zwds-app .zwds-trine-arrowhead {
+  fill: rgba(223, 82, 92, .88);
+  stroke: rgba(15, 15, 16, .52);
+  stroke-width: .35;
+}
+#zwds-app .zwds-center::before {
+  border-color: rgba(198, 169, 107, .13);
+  box-shadow: 0 12px 34px rgba(0, 0, 0, .28);
+}
+@media (max-width: 760px) {
+  #zwds-app .zwds-trine-path,
+  #zwds-app .zwds-trine-path--opposite { stroke-width: .62; }
+}
